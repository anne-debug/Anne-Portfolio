# The password for the IBM watsonx Builder Control Plane case study.
# Server-side only: no NEXT_PUBLIC_ prefix, so it is never sent to the browser.
# Set the same variable in the deployment environment; do not commit a value.
IBM_CASE_STUDY_PASSWORD=

# --- Request Password dialog -------------------------------------------------
# Both must be set for the dialog to send server-side. With either missing the
# dialog still works: it hands the finished message to the visitor's own mail
# client instead. It never accepts a message and drops it.
#
# RESEND_API_KEY        an API key from the mail provider
# REQUEST_FROM_ADDRESS  the verified sender the mail goes out as,
#                       e.g. "Anne Lin <hello@yourdomain.com>"
# PASSWORD_REQUEST_TO   optional; defaults to annelin.yuen@gmail.com
RESEND_API_KEY=
REQUEST_FROM_ADDRESS=
PASSWORD_REQUEST_TO=
