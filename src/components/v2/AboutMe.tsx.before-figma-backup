            <span className="absolute bottom-0 left-0 h-full w-[20px] bg-[rgba(79,79,79,0.28)]" />
          </motion.div>
        ))}
        <motion.div className="absolute left-[240px] top-[40px] h-[300px] w-[39px]" style={{ rotate: 12 }} whileHover={{ y: -113 }} transition={{ type: "spring", duration: 0.5, bounce: 0 }}>
