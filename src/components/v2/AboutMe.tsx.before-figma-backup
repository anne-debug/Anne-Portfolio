const BOARD = `${IMG}/board`;

/**
 * One sticker image from Anne's Framer board (clips, keychains, 2026, sun,
 * pencil). The files live in public/images/about/board and are downloaded by
 * `node scripts/fetch-board-assets.mjs`. Until a file is there, the drawn
 * stand-in passed as children is shown instead, so the board never has holes.
 */
function Sticker({ name, className, style, over, children }: { name: string; className?: string; style?: CSSProperties; over?: ReactNode; children?: ReactNode }) {
  const ref = useRef<HTMLImageElement>(null);
  const [missing, setMissing] = useState(false);
  useEffect(() => {
    // an image that failed before React attached never fires onError
    const el = ref.current;
    if (el && el.complete && el.naturalWidth === 0) setMissing(true);
  }, []);
  if (missing) return <>{children}</>;
  return (
    <>
      {/* eslint-disable-next-line @next/next/no-img-element */}
      <img ref={ref} src={`${BOARD}/${name}.png`} alt="" draggable={false} className={`object-contain ${className ?? ""}`} style={style} onError={() => setMissing(true)} />
      {over}
    </>
  );
}

function Photo({ src, alt, className, position }: { src: string; alt: string; className?: string; position?: string }) {
  return (
    <div className={`relative overflow-hidden ${className ?? ""}`}>
      <Image src={`${IMG}/${src}`} alt={alt} fill sizes="260px" className="object-cover" style={{ objectPosition: position }} draggable={false} />
    </div>
  );
}

/** One thing on the board: placed in board px, draggable, springs back. */
function Item({
  x,
  y,
  w,
  h,
  rot = 0,
  z = 1,
  label,
  children,
}: {
  x: number;
  y: number;
  w: number;
  h?: number;
  rot?: number;
  z?: number;
  label?: string;
  children: ReactNode;
}) {
  const reduce = useReducedMotion() ?? false;
  return (
    <motion.div
      className="absolute cursor-grab touch-none active:cursor-grabbing"
      style={{ left: x, top: y, width: w, height: h, rotate: rot, zIndex: z }}
      drag={!reduce}
      dragSnapToOrigin
      dragElastic={0.6}
      dragTransition={{ bounceStiffness: 400, bounceDamping: 30 }}
      whileDrag={{ scale: 1.04, zIndex: 20 }}
      aria-label={label}
    >
      {children}
    </motion.div>
  );
}

